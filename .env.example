# PromptBench — environment template
# Copy to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real keys. The key is never logged or printed.

# --- Required ----------------------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# --- Optional: experiment defaults (override without touching code) ----------
# Model identifier used for every strategy in a run.
PROMPTBENCH_MODEL=gemini-2.5-flash

# Deterministic decoding: temperature is held constant across all strategies.
PROMPTBENCH_TEMPERATURE=0.0

# Number of IMDb samples in the fixed evaluation subset.
PROMPTBENCH_SAMPLE_SIZE=100

# Seed controlling the sampling of the evaluation subset (reproducibility).
PROMPTBENCH_RANDOM_SEED=42

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
PROMPTBENCH_LOG_LEVEL=INFO
