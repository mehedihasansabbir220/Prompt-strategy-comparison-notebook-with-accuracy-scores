# PromptBench — environment template
# Copy to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real keys. The key is never logged or printed.

# --- Required ----------------------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# --- Optional: experiment defaults (override without touching code) ----------
# Model identifier used for every strategy in a run.
PROMPTBENCH_MODEL=gemini-3.5-flash

# Deterministic decoding: temperature is held constant across all strategies.
PROMPTBENCH_TEMPERATURE=0.0

# Number of IMDb samples in the fixed evaluation subset for a real benchmark run.
PROMPTBENCH_BENCHMARK_SAMPLE_SIZE=100

# Small subset used to smoke-test the pipeline before spending API quota.
PROMPTBENCH_DEV_SAMPLE_SIZE=10

# Seed controlling the sampling of the evaluation subset (reproducibility).
PROMPTBENCH_RANDOM_SEED=42

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
PROMPTBENCH_LOG_LEVEL=INFO

# Root directory for persisted runs (relative paths resolve from the repo root).
PROMPTBENCH_RESULTS_DIR=results
